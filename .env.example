# Приклад налаштувань. Скопіюйте цей файл у `.env.local` і заповніть значення.
# Реальні ключі НІКОЛИ не додаємо в репозиторій: у проді вони лежать у налаштуваннях Vercel
# (Project → Settings → Environment Variables).
#
# Зараз прототип працює без жодних ключів. Нижче — те, що знадобиться на наступних етапах.

# --- Telegram (етап 0 / 2) ---
# Токен тестового бота з @BotFather
TELEGRAM_BOT_TOKEN=
# Чат студії, куди бот надсилає «Надіслати студії» (ID чату)
STUDIO_CHAT_ID=
# Telegram ID працівників студії через кому (поки ролі без таблиці)
STAFF_TELEGRAM_IDS=

# --- База даних і фото: Supabase (етап 2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Модель зображень (етап 3), обирається після тесту ---
IMAGE_MODEL_PROVIDER=
IMAGE_MODEL_API_KEY=
