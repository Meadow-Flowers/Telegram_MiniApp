# Приклад налаштувань. Скопіюйте цей файл у `.env.local` і заповніть значення.
# Реальні ключі НІКОЛИ не додаємо в репозиторій: у проді вони лежать у налаштуваннях Vercel
# (Project → Settings → Environment Variables).
#
# Зараз прототип працює без жодних ключів. Нижче — те, що знадобиться на наступних етапах.

# --- Telegram (етап 0 / 2) ---
# Токен тестового бота з @BotFather
TELEGRAM_BOT_TOKEN=
# Чат студії, куди бот надсилає «Надіслати студії» (ID чату)
STUDIO_CHAT_ID=
# Ролі (клієнт / працівник / власник) зберігаються в базі, у таблиці app_users, а не тут.

# --- База даних і фото: Supabase (етап 2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Модель зображень (OpenAI) ---
# Без ключа працює заглушка (картинка-напис), з ключем викликається справжня модель.
OPENAI_API_KEY=
# Лише локально: IMAGE_STUB=1 примусово вмикає заглушку навіть із ключем (без витрат), а
# IMAGE_STUB_DELAY_MS задає, скільки мілісекунд вона «думає» (за замовчуванням 6000). У Vercel не ставити.
IMAGE_STUB=
IMAGE_STUB_DELAY_MS=
# Необов'язково: модель і якість (за замовчуванням gpt-image-2.6-sunburst і medium).
IMAGE_MODEL=
IMAGE_QUALITY=
# Необов'язково: low | medium | high (якщо порожньо, модель сама обирає high)
IMAGE_COMPLEXITY=

# --- Лише для локальної розробки ---
# Ваш Telegram ID (число з @userinfobot). Дає змогу входити як власник, відкриваючи додаток у браузері на комп'ютері.
# У продакшені (Vercel) це не працює й не потрібно.
NEXT_PUBLIC_DEV_TELEGRAM_ID=
